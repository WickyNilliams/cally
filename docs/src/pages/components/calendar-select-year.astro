---
import ApiLayout from "../../layouts/ApiLayout.astro";
import ApiReference from "../../components/ApiReference.astro";
import Link from "../../components/Link.astro";
import Example from "../../components/Example.astro";
---

<ApiLayout
  heading="<calendar-select-year>"
  meta={{
    title: "<calendar-select-year> API",
    description:
      "The calendar-select-year component allows users to select the year for the calendar. Find out how to use its properties, methods, events, and styling options.",
  }}
>
  <p>
    This component allows users to quickly jump to a chosen year. It should not
    be used alone, but as a descendant of one of
    <Link href="/components/calendar-date/"
      ><code>{`<calendar-date>`}</code></Link
    >,
    <Link href="/components/calendar-range/"
      ><code>{`<calendar-range>`}</code></Link
    > or
    <Link href="/components/calendar-multi/"
      ><code>{`<calendar-multi>`}</code></Link
    >.
  </p>

  <Example lineLength={72}>
    <calendar-date>
      <calendar-select-year slot="heading" max-years="20"
      ></calendar-select-year>
      <calendar-month></calendar-month>
    </calendar-date>
  </Example>

  <ApiReference tag="calendar-select-year">
    <Fragment slot="parts">
      <p>
        CSS parts allow for fine-grained styling and theming. They target specific
        elements inside the component.
      </p>
    </Fragment>
  </ApiReference>
</ApiLayout>

<style is:global>
  calendar-date {
    margin-inline: auto;
  }
  calendar-select-year::part(label) {
    position: absolute;
    transform: scale(0);
  }

  calendar-select-year {
    display: block;
  }
  calendar-select-year::part(select) {
    padding: 0;
  }
</style>
