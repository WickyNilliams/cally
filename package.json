{
  "name": "cally",
  "version": "0.9.2",
  "description": "small, feature-rich calendar components",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/cally.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calendar-date": {
      "types": "./dist/calendar-date/calendar-date.d.ts",
      "import": "./dist/calendar-date.js"
    },
    "./calendar-range": {
      "types": "./dist/calendar-range/calendar-range.d.ts",
      "import": "./dist/calendar-range.js"
    },
    "./calendar-multi": {
      "types": "./dist/calendar-multi/calendar-multi.d.ts",
      "import": "./dist/calendar-multi.js"
    },
    "./calendar-month": {
      "types": "./dist/calendar-month/calendar-month.d.ts",
      "import": "./dist/calendar-month.js"
    },
    "./calendar-heading": {
      "types": "./dist/calendar-heading/calendar-heading.d.ts",
      "import": "./dist/calendar-heading.js"
    },
    "./calendar-select-month": {
      "types": "./dist/calendar-year-month/calendar-select-month.d.ts",
      "import": "./dist/calendar-select-month.js"
    },
    "./calendar-select-year": {
      "types": "./dist/calendar-year-month/calendar-select-year.d.ts",
      "import": "./dist/calendar-select-year.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WickyNilliams/cally"
  },
  "scripts": {
    "start": "vite",
    "clean": "rm -rf dist docs/dist",
    "prebuild": "npm run clean",
    "build": "npm run build:package && npm run astro:build",
    "build:package": "vite build && vite build --mode standalone",
    "check-types": "attw --pack . --profile esm-only",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "astro:dev": "astro dev --root ./docs",
    "astro:build": "astro check --root ./docs && astro build --root ./docs",
    "astro:preview": "astro preview --root ./docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@astrojs/check": "^0.9.4",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "astro": "^5.5.6",
    "hastscript": "^9.0.1",
    "playwright": "^1.50.1",
    "postcss-nesting": "^13.0.1",
    "prettier": "^3.5.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.0.16"
  }
}
