{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // as the docs instruct, rather than including the file directly
    "types": ["./globals.d.ts"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
