{
  "include": ["src/**/*.ts", "src/**/*.tsx", "./vitest.d.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    // jsx is only used by tests, to declare fixtures
    "jsx": "react-jsx",
    "jsxImportSource": "test-jsx",
    "paths": {
      "test-jsx/*": ["./src/utils/test-jsx/*"]
    }
  }
}
