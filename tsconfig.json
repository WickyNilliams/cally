{
  "include": ["src/**/*.ts", "src/**/*.tsx", "./vitest.d.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    // jsx in components is compiled to strings of html at build time.
    // tests opt into "test-jsx", which creates DOM nodes for fixtures.
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-static",
    "paths": {
      "jsx-static/*": ["./src/utils/jsx-static/*"],
      "test-jsx/*": ["./src/utils/test-jsx/*"]
    }
  }
}
