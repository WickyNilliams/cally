{
  "include": ["src/**/*.ts", "src/**/*.tsx", "./vitest.d.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    // JSX is only used in tests, with a tiny DOM-producing runtime
    "jsx": "react-jsx",
    "jsxImportSource": "#test-jsx",
    "moduleResolution": "bundler"
  }
}
